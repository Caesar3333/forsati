{
  "profileVersion": 1,
  "name": "ما لا يُقال — الملف الإنتاجي العام",
  "notes": "Single source of production rules. Every value is editable in the app (options UI), replaceable by importing this file, or changeable through a natural-language prompt (with diff + approve).",

  "camera": {
    "angles": [
      { "id": "front_mcu", "labelAr": "أمامية متوسطة", "prompt": "Front medium close-up, eye level, 50mm, microphone entering from frame-right", "useFor": ["default", "explanation", "question_to_viewer"] },
      { "id": "side_tight", "labelAr": "جانبية مقرّبة", "prompt": "Tight three-quarter / profile close-up from his right side, 85mm, microphone in the foreground frame-left", "useFor": ["reflection", "self_confrontation", "emotional_line"] },
      { "id": "wide", "labelAr": "واسعة", "prompt": "Wide shot of the whole studio, host small in the lower half", "useFor": ["opening", "chapter_change"] }
    ],
    "angleRules": {
      "alternateEveryChunk": true,
      "minSecondsPerAngle": 6,
      "maxSecondsPerAngle": 15,
      "reflectiveKeywords": ["حالك", "حالنا", "طبيعتي", "من متى", "بتتعبك", "تسكت", "أصعب حوار"]
    },
    "movement": {
      "default": "very slow push-in (2–5% over the shot)",
      "options": ["slow push-in", "subtle lateral pan", "slow pull-back", "locked-off"],
      "maxSpeedPctPerSecond": 1.0,
      "forbidden": ["whip pan", "shake", "fast zoom"]
    }
  },

  "lighting": {
    "style": "moody low-key, soft chiaroscuro",
    "key": "soft warm key light from camera-left",
    "practicals": "amber glass globe Edison lamp in background",
    "colorTemperatureK": 3200,
    "background": "warm bokeh, walnut slats falling into shadow",
    "promptText": "Moody low-key warm lighting with soft chiaroscuro: warm tungsten key from camera-left sculpting the face, gentle falloff into shadow, amber practical glow and creamy bokeh behind, shallow depth of field (f/2)."
  },

  "pacing": {
    "visualBreathing": true,
    "minHoldAfterKeyLineSec": 1.0,
    "silenceAfterLines": [{ "text": "من متى أنا هيك؟", "musicDuckToSilenceSec": 1.2 }, { "text": "هل بدّي أضل هيك؟", "musicDuckToSilenceSec": 1.0 }],
    "maxCutsPerMinute": 8
  },

  "visualMetaphors": [
    { "id": "old_photo_burn", "labelAr": "احتراق الصورة القديمة", "meaning": "letting go of an old interpretation", "triggers": ["تفسير قديم", "الماضي"], "recipe": "old-photo-burn", "sfx": ["paper_burn_soft", "film_crackle"] },
    { "id": "fogged_mirror", "labelAr": "المرآة الضبابية", "meaning": "seeing the self", "triggers": ["حالنا", "حالك", "نسخة"], "recipe": "mirror-reveal", "sfx": ["glass_breath"] },
    { "id": "label_cards", "labelAr": "بطاقات الجمل الجاهزة", "meaning": "labels we give ourselves", "triggers": ["«أنا"], "recipe": "label-stack", "sfx": ["paper_tick", "pen_scratch"] },
    { "id": "question_lens", "labelAr": "عدسة السؤال", "meaning": "one question changes how we see", "triggers": ["سؤال"], "recipe": "question-lens", "sfx": ["warm_swoosh"] },
    { "id": "inner_universe", "labelAr": "عالم كامل جوّا", "meaning": "every person has a whole world inside", "triggers": ["عالم كامل"], "recipe": "silhouette-particles", "sfx": ["shimmer_low"] },
    { "id": "incomplete_puzzle", "labelAr": "الصورة الناقصة", "meaning": "we don't see the full picture", "triggers": ["الصورة كاملة"], "recipe": "puzzle-complete", "sfx": ["soft_click"] },
    { "id": "rewind", "labelAr": "الترجيع", "meaning": "think about it again", "triggers": ["مرّة تانية"], "recipe": "rewind-stop", "sfx": ["tape_rewind_soft"] }
  ],

  "kineticTypography": {
    "fonts": { "body": "IBM Plex Sans Arabic", "bodyWeight": 300, "emphasisWeight": 600, "logo": "Aref Ruqaa" },
    "colors": { "text": "#EDE6D6", "emphasis": "#B8835A", "muted": "#9A9590" },
    "captionStyles": {
      "lower": { "sizePx": 64, "y": 1290, "maxWidthPx": 900, "maxLines": 2, "backdrop": "bottom dark gradient" },
      "center_big": { "sizePx": 104, "y": "center", "maxWidthPx": 900, "maxLines": 3 }
    },
    "animation": {
      "karaoke": { "baseOpacity": 0.55, "wordRiseMs": 250 },
      "cardIn": { "durationMs": 500, "blurPx": 8, "risePx": 8, "easing": "expo-out" },
      "cardOut": { "durationMs": 400 },
      "wordReveal": { "type": "mask-rtl", "risePx": 34, "durationMs": 500 },
      "emphasis": { "underlineDrawMs": 500, "scale": 1.12 }
    },
    "rules": ["never letter-space Arabic", "never split words into letters", "RTL only", "no text in bottom 20% or right 120px", "never over the face"]
  },

  "transitions": {
    "defaultAtoB": "blur_dissolve",
    "library": {
      "cut": { "durationSec": 0 },
      "blur_dissolve": { "durationSec": 0.45, "blurPx": 10 },
      "zoom_blur": { "durationSec": 0.45, "outScale": 1.12, "inScale": 0.94 },
      "light_sweep": { "durationSec": 0.4, "color": "#FFBE78", "blend": "screen" },
      "texture_wipe": { "durationSec": 0.5, "texture": "film_grain_burn" }
    },
    "sfxOnTransition": "warm_swoosh"
  },

  "audio": {
    "voice": { "targetLUFS": -14.0, "truePeakDBTP": -1.0, "highpassHz": 80, "compression": "2:1–3:1 gentle", "normalizeScope": "programme" },
    "music": {
      "style": "ambient / neoclassical, no beat, no vocals",
      "instruments": ["soft felt piano", "warm deep bass drone", "airy pad"],
      "levelBelowVoiceLU": 15,
      "duckDb": -5.5, "duckAttackMs": 30, "duckReleaseMs": 450,
      "arc": ["calm", "tension 1:35–2:00", "release from 2:31", "reflective", "warm ending with one low piano note"]
    },
    "sfxLibrary": [
      { "id": "warm_swoosh", "labelAr": "سووش دافئ", "use": "word/card appear, A↔B cuts", "levelDb": -26 },
      { "id": "paper_burn_soft", "labelAr": "احتراق ورقة خفيف", "use": "old_photo_burn", "levelDb": -28 },
      { "id": "film_crackle", "labelAr": "طقطقة فيلم", "use": "old photos bed", "levelDb": -34 },
      { "id": "heartbeat_faint", "labelAr": "دقات قلب خافتة", "use": "self-reflection moments only, max 6 s", "levelDb": -32, "enabled": true },
      { "id": "paper_tick", "labelAr": "طقّة ورقة", "use": "label card lands", "levelDb": -30 },
      { "id": "pen_scratch", "labelAr": "شطب قلم", "use": "strike-through", "levelDb": -30 },
      { "id": "sub_hit_soft", "labelAr": "ضربة منخفضة ناعمة", "use": "climax word", "levelDb": -24 },
      { "id": "reverse_swell", "labelAr": "تصاعد عكسي", "use": "into climax", "levelDb": -26 },
      { "id": "shimmer_low", "labelAr": "لمعان خافت", "use": "logo / inner universe", "levelDb": -30 }
    ]
  },

  "artDirection": {
    "palette": { "bg": "#0B0D10", "bg2": "#10181B", "walnut": "#6B4A2F", "amber": "#E9B47A", "navy": "#1C2433", "ivory": "#EDE6D6", "copper": "#B8835A" },
    "grade": "teal-black shadows, warm amber highlights, slightly desaturated, cooler first half, warmer from 2:31",
    "grain": 0.04, "vignette": 0.6,
    "forbidden": ["neon", "bright yellow/red", "bounce", "shake", "emoji", "meme pops", "8k/masterpiece filler words"]
  },

  "skills": {
    "promptEngineering": { "requireFiveElements": ["subject", "composition_camera", "action_performance", "lighting_atmosphere", "style_constraints"], "requireLocks": ["FACE", "WARDROBE", "SET", "IDENTITY"], "identityMustMention": ["mole", "LEFT", "goatee"] },
    "timelineSync": { "captionLeadMs": 100, "captionTailMs": 300, "snapToSilencesDb": -35, "brollMustCoverKeyLine": true, "maxAvOffsetMs": 33 },
    "artDirectionCheck": { "sampleEverySec": 2, "maxPixelsOutsidePalettePct": 15, "checkSafeZones": true, "checkTextOverFace": true }
  }
}
