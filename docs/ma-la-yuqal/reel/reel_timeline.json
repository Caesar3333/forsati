   "start": 5.53,
   "end": 12.32,
   "phrases": [
    {
     "t0": 5.64,
     "t1": 10.33,
     "text": "المشكلة إنّا مرّات منضل عايشين جوّا تفسير قديم… حتى بعد ما تتغيّر الظروف"
    },
    {
     "t0": 10.59,
     "t1": 12.19,
     "text": "والناس… وحتى إحنا نفسنا"
    }
   ]
  },
  {
   "role": "labels",
   "src": [
    102.03,
    110.66
   ],
   "start": 12.77,
   "end": 21.4,
   "phrases": [
    {
     "t0": 12.88,
     "t1": 15.04,
     "text": "ولا تعوّدنا نحكي عن حالنا بجمل جاهزة"
    },
    {
     "t0": 15.34,
     "t1": 16.47,
     "text": "«أنا عصبي»"
    },
    {
     "t0": 16.77,
     "t1": 17.73,
     "text": "«أنا ما بثق بحدا»"
    },
    {
     "t0": 18.0,
     "t1": 19.39,
     "text": "«أنا ما بحب أطلب مساعدة»"
    },
    {
     "t0": 19.68,
     "t1": 21.27,
     "text": "«أنا هيك… وما رح أتغيّر»"
    }
   ]
  },
  {
   "role": "climax",
   "src": [
    111.5,
    118.91
   ],
   "start": 21.85,
   "end": 29.26,
   "phrases": [
    {
     "t0": 21.96,
     "t1": 25.81,
     "text": "بس تخيّل لو إنّك بدل ما تعتبر هاي الجمل تعريف نهائي إلك"
    },
    {
     "t0": 26.14,
     "t1": 27.82,
     "text": "رجعت خطوة لورا… وسألت حالك:"
    },
    {
     "t0": 28.26,
     "t1": 29.02,
     "text": "من متى أنا هيك؟"
    }
   ]
  },
  {
   "role": "wound",
   "src": [
    126.46,
    135.71
   ],
   "start": 30.61,
   "end": 39.86,
   "phrases": [
    {
     "t0": 30.72,
     "t1": 35.3,
     "text": "يمكن تكتشف إنك ما كنت دايماً عصبي… وإنك ما كنت دايماً تخاف تثق"
    },
    {
     "t0": 35.58,
     "t1": 39.61,
     "text": "وإنك بيوم من الأيام كنت تحكي عن اللي بوجعك… قبل ما تتعلّم تسكت"
    }
   ]
  },
  {
   "role": "new_question",
   "src": [
