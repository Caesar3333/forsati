    150.83
   ],
   "start": 40.31,
   "end": 48.46,
   "phrases": [
    {
     "t0": 40.42,
     "t1": 43.4,
     "text": "وهون بالنسبة إلي… بيبلّش نوع مختلف من الفهم"
    },
    {
     "t0": 43.74,
     "t1": 48.23,
     "text": "إنك ما تكتفي تسأل: ليش أنا هيك؟ بل تسأل كمان: هل بدّي أضل هيك؟"
    }
   ]
  },
