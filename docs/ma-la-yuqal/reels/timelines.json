    "t0": 0.36,
    "t1": 2.52,
    "text": "ولا تعوّدنا نحكي عن حالنا بجمل جاهزة"
   },
   "29": {
    "t0": 2.82,
    "t1": 3.95,
    "text": "«أنا عصبي»"
   },
   "30": {
    "t0": 4.25,
    "t1": 5.21,
    "text": "«أنا ما بثق بحدا»"
   },
   "31": {
    "t0": 5.48,
