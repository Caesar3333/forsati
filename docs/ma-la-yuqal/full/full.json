{
 "duration": 293.15,
 "cards": [
  {
   "start": 0.0,
   "end": 1.9,
   "text": "في يوم وأنا قاعد بفكّر بموقف",
   "emphasis": ""
  },
  {
   "start": 1.9,
   "end": 2.93,
   "text": "صار معي من فترة",
   "emphasis": ""
  },
  {
   "start": 3.45,
   "end": 5.41,
   "text": "موقف… لو سألتني عنه وقتها",
   "emphasis": ""
  },
  {
   "start": 5.67,
   "end": 7.62,
   "text": "كنت رح أحكيلك إنّي فاهمه منيح…",
   "emphasis": ""
  },
  {
   "start": 7.62,
   "end": 8.39,
   "text": "فاهم شو صار",
   "emphasis": ""
  },
  {
   "start": 8.65,
   "end": 9.29,
   "text": "وليش صار…",
   "emphasis": ""
  },
  {
   "start": 9.29,
   "end": 10.4,
   "text": "ومين كان معه حق",
   "emphasis": ""
  },
  {
   "start": 10.68,
   "end": 12.47,
   "text": "ومين كان لازم يتصرّف بطريقة تانية",
   "emphasis": ""
  },
  {
   "start": 12.95,
   "end": 14.48,
   "text": "كنت مرتّب القصة براسي…",
   "emphasis": "مرتّب القصة"
  },
  {
   "start": 14.48,
   "end": 15.65,
   "text": "من أولها لآخرها",
   "emphasis": ""
  },
  {
   "start": 16.13,
   "end": 17.67,
   "text": "بس وأنا برجع أفكّر فيها…",
   "emphasis": ""
  },
  {
   "start": 17.67,
   "end": 19.04,
   "text": "خطر ببالي سؤال صغير",
   "emphasis": "سؤال صغير"
  },
  {
   "start": 19.49,
   "end": 21.26,
   "text": "طيب… أنا بعرف شو صار فعلاً؟",
   "emphasis": "فعلاً"
  },
  {
   "start": 21.56,
   "end": 23.02,
   "text": "ولا بعرف بس كيف أنا شفت",
   "emphasis": ""
  },
  {
   "start": 23.02,
   "end": 24.0,
   "text": "وفسّرت اللي صار؟",
   "emphasis": "فسّرت"
  },
  {
   "start": 25.11,
   "end": 27.53,
   "text": "الغريب إنه السؤال ما وقف عند الموقف نفسه",
   "emphasis": ""
  },
  {
   "start": 27.93,
   "end": 29.72,
   "text": "بلّش ياخدني لمواقف قديمة…",
   "emphasis": ""
  },
  {
   "start": 29.72,
   "end": 31.16,
   "text": "وأشخاص اختلفت معهم",
   "emphasis": ""
  },
  {
   "start": 31.43,
   "end": 33.29,
   "text": "وأشياء كنت مقتنع فيها من سنين",
   "emphasis": ""
  },
  {
   "start": 33.66,
   "end": 36.16,
   "text": "واكتشفت إنه المعنى اللي بنعطيه لتجاربنا",
   "emphasis": "المعنى"
  },
  {
   "start": 36.16,
   "end": 38.3,
   "text": "ممكن يضل معنا أطول من التجربة نفسها",
   "emphasis": ""
  },
  {
   "start": 38.71,
   "end": 42.49,
   "text": "ومع الوقت منِنسى إنها كانت مواقف مرّت بحياتنا…",
   "emphasis": ""
  },
  {
   "start": 42.49,
   "end": 46.38,
   "text": "ومنصير نتعامل معها كأنها حقائق عنّا وعن الناس",
   "emphasis": "حقائق"
  },
  {
   "start": 47.48,
   "end": 48.97,
   "text": "والمشكلة مش إنّا منحس…",
   "emphasis": ""
  },
  {
   "start": 48.97,
   "end": 49.67,
   "text": "أو بنتأثر…",
   "emphasis": ""
  },
  {
   "start": 49.67,
   "end": 51.24,
   "text": "أو حتى بنغلط بالتفسير",
   "emphasis": ""
  },
  {
   "start": 51.56,
   "end": 54.63,
   "text": "المشكلة إنّا مرّات منضل عايشين جوّا تفسير قديم…",
   "emphasis": "تفسير قديم"
  },
  {
   "start": 54.63,
   "end": 56.25,
   "text": "حتى بعد ما تتغيّر الظروف",
   "emphasis": ""
  },
  {
   "start": 56.51,
   "end": 58.11,
   "text": "والناس… وحتى إحنا نفسنا",
   "emphasis": ""
  },
  {
   "start": 58.63,
   "end": 60.35,
   "text": "وبتذكّرني هاي الفكرة بشغلة تانية",
   "emphasis": ""
  },
  {
   "start": 60.75,
   "end": 62.56,
   "text": "كم مرّة قابلنا شخص وطلعنا من",
   "emphasis": ""
  },
  {
   "start": 62.56,
   "end": 63.79,
   "text": "عنده بانطباع معيّن",
   "emphasis": "انطباع"
  },
  {
   "start": 64.12,
   "end": 66.15,
   "text": "حكينا إنه مغرور… بارد…",
   "emphasis": ""
  },
  {
   "start": 66.15,
   "end": 67.94,
   "text": "عصبي… أو أسلوبه سيّئ",
   "emphasis": ""
  },
  {
   "start": 68.21,
   "end": 70.1,
   "text": "وحطّيناه بمكان معيّن براسنا…",
   "emphasis": ""
  },
  {
   "start": 70.1,
   "end": 71.91,
   "text": "مع إنّا ما شفنا منه غير لحظة",
   "emphasis": "لحظة"
  },
  {
   "start": 72.22,
   "end": 74.04,
   "text": "ويمكن فعلاً كان عنده تصرّف غلط",
   "emphasis": ""
  },
  {
   "start": 74.04,
   "end": 75.39,
   "text": "لازم يتحمّل مسؤوليته",
   "emphasis": ""
  },
  {
   "start": 75.73,
   "end": 77.31,
   "text": "بس إحنا ما منعرف شو الحقيقة",
   "emphasis": ""
  },
  {
   "start": 77.31,
   "end": 78.1,
   "text": "حتى نحكم عليه",
   "emphasis": ""
  },
  {
   "start": 78.47,
   "end": 80.52,
   "text": "والفرق كبير بين إنك تعترف إنك",
   "emphasis": ""
  },
  {
   "start": 80.52,
   "end": 81.97,
   "text": "ما بتعرف القصة كاملة…",
   "emphasis": ""
  },
  {
   "start": 81.97,
   "end": 83.85,
   "text": "وبين إنك تتصرّف كأنك عارفها",
   "emphasis": "كأنك عارفها"
  },
  {
   "start": 84.14,
   "end": 85.8,
   "text": "مش مطلوب منك تبرّر للناس…",
   "emphasis": ""
  },
  {
   "start": 85.8,
   "end": 87.82,
   "text": "ولا تعطي كل شخص فرصة بلا حدود [؟]",
   "emphasis": ""
  },
  {
   "start": 88.14,
   "end": 90.82,
   "text": "بس يمكن المطلوب تضل واعي لحدود اللي شفته…",
   "emphasis": "واعي"
  },
  {
   "start": 90.82,
   "end": 93.75,
   "text": "وما تبني عليه أفكار وتفسيرات وتحوّله لحقيقة [؟]",
   "emphasis": ""
  },
  {
   "start": 94.91,
   "end": 96.86,
   "text": "واللي استوقفني أكتر إنه نفس الإشي",
   "emphasis": ""
  },
  {
   "start": 96.86,
   "end": 97.77,
   "text": "بيصير معنا إحنا",
   "emphasis": ""
  },
  {
   "start": 98.1,
   "end": 99.6,
   "text": "إحنا منحاول نفهم الناس…",
   "emphasis": ""
  },
  {
   "start": 99.6,
   "end": 101.82,
   "text": "بس هل بنحاول نفهم حالنا بنفس القدر؟",
   "emphasis": "حالنا"
  },
  {
   "start": 102.14,
   "end": 104.3,
   "text": "ولا تعوّدنا نحكي عن حالنا بجمل جاهزة",
   "emphasis": "جمل جاهزة"
  },
  {
   "start": 104.6,
   "end": 105.73,
   "text": "«أنا عصبي»",
   "emphasis": ""
  },
  {
   "start": 106.03,
   "end": 106.99,
   "text": "«أنا ما بثق بحدا»",
   "emphasis": ""
  },
  {
   "start": 107.26,
   "end": 108.65,
   "text": "«أنا ما بحب أطلب مساعدة»",
   "emphasis": ""
  },
  {
   "start": 108.94,
   "end": 109.54,
   "text": "«أنا هيك…",
   "emphasis": ""
  },
  {
   "start": 109.54,
   "end": 110.53,
   "text": "وما رح أتغيّر»",
   "emphasis": ""
  },
  {
   "start": 111.61,
   "end": 113.08,
   "text": "بس تخيّل لو إنّك بدل ما",
   "emphasis": ""
  },
  {
   "start": 113.08,
   "end": 115.46,
   "text": "تعتبر هاي الجمل تعريف نهائي إلك",
   "emphasis": "تعريف نهائي"
  },
  {
   "start": 115.79,
   "end": 116.75,
   "text": "رجعت خطوة لورا…",
   "emphasis": ""
  },
  {
   "start": 116.75,
   "end": 117.47,
   "text": "وسألت حالك:",
   "emphasis": ""
  },
  {
   "start": 117.91,
   "end": 118.67,
   "text": "من متى أنا هيك؟",
   "emphasis": "من متى"
  },
  {
   "start": 119.08,
   "end": 121.25,
   "text": "شو اللي صار وخلّاني أتصرّف بهالطريقة؟",
   "emphasis": ""
  },
  {
   "start": 121.55,
   "end": 122.89,
   "text": "وهل هاي فعلاً طبيعتي؟",
   "emphasis": "طبيعتي"
  },
  {
   "start": 122.89,
   "end": 125.15,
   "text": "ولا طريقة تعلّمتها بوقت كنت محتاج",
   "emphasis": ""
  },
  {
   "start": 125.15,
   "end": 126.16,
   "text": "فيها أحمي حالي؟",
   "emphasis": ""
  },
  {
   "start": 126.57,
   "end": 129.1,
   "text": "يمكن تكتشف إنك ما كنت دايماً عصبي…",
   "emphasis": ""
  },
  {
   "start": 129.1,
   "end": 131.15,
   "text": "وإنك ما كنت دايماً تخاف تثق [؟]",
   "emphasis": ""
  },
  {
   "start": 131.43,
   "end": 133.36,
   "text": "وإنك بيوم من الأيام كنت تحكي",
   "emphasis": ""
  },
  {
   "start": 133.36,
   "end": 134.28,
   "text": "عن اللي بوجعك…",
   "emphasis": ""
  },
  {
   "start": 134.28,
   "end": 135.46,
   "text": "قبل ما تتعلّم تسكت",
   "emphasis": "تسكت"
  },
  {
   "start": 135.9,
   "end": 138.1,
   "text": "ويمكن تكتشف إنه في أشياء ساعدتك",
   "emphasis": ""
  },
  {
   "start": 138.1,
   "end": 139.87,
   "text": "تتجاوز مرحلة صعبة بحياتك",
   "emphasis": ""
  },
  {
   "start": 140.17,
   "end": 142.35,
   "text": "بس اليوم صارت هي نفسها اللي بتتعبك",
   "emphasis": "بتتعبك"
  },
  {
   "start": 142.79,
   "end": 144.02,
   "text": "وهون بالنسبة إلي…",
   "emphasis": ""
  },
  {
   "start": 144.02,
   "end": 145.77,
   "text": "بيبلّش نوع مختلف من الفهم",
   "emphasis": "الفهم"
  },
  {
   "start": 146.11,
   "end": 147.54,
   "text": "إنك ما تكتفي تسأل:",
   "emphasis": ""
  },
  {
   "start": 147.54,
   "end": 148.46,
   "text": "ليش أنا هيك؟",
   "emphasis": ""
  },
  {
   "start": 148.46,
   "end": 149.48,
   "text": "بل تسأل كمان:",
   "emphasis": ""
  },
  {
   "start": 149.48,
   "end": 150.6,
   "text": "هل بدّي أضل هيك؟",
   "emphasis": "بدّي أضل"
  },
  {
   "start": 151.8,
   "end": 154.02,
   "text": "لأنه مش كل إشي تعوّدنا عليه بناسبنا",
   "emphasis": ""
  },
  {
   "start": 154.29,
   "end": 156.16,
   "text": "ومش كل إشي تعلّمنا نعمله حتى",
   "emphasis": ""
  },
  {
   "start": 156.16,
   "end": 157.53,
   "text": "ننجو من مرحلة معيّنة…",
   "emphasis": "ننجو"
  },
  {
   "start": 157.53,
   "end": 159.4,
   "text": "لازم يضل يرافقنا طول العمر",
   "emphasis": ""
  },
  {
   "start": 159.7,
   "end": 161.9,
   "text": "بس التغيير كمان مش إنك ترفض حالك…",
   "emphasis": ""
  },
  {
   "start": 161.9,
   "end": 163.84,
   "text": "أو تعتبر كل اللي كنت عليه غلط",
   "emphasis": ""
  },
  {
   "start": 164.23,
   "end": 166.4,
   "text": "يمكن التغيير يبلّش لما تفهم حالك",
   "emphasis": "تفهم حالك"
  },
  {
   "start": 166.4,
   "end": 167.49,
   "text": "من غير ما تظلمها…",
   "emphasis": ""
  },
  {
   "start": 167.49,
   "end": 169.83,
   "text": "وتتحمّل مسؤوليتها من غير ما تكرهها",
   "emphasis": ""
  },
  {
   "start": 170.09,
   "end": 171.53,
   "text": "وبين كل هاي الأفكار…",
   "emphasis": ""
  },
  {
   "start": 171.53,
   "end": 173.16,
   "text": "برجع أتذكّر شغلة بسيطة",
   "emphasis": ""
  },
  {
   "start": 173.67,
   "end": 175.26,
   "text": "إنه كل إنسان بنقابله…",
   "emphasis": ""
  },
  {
   "start": 175.26,
   "end": 176.67,
   "text": "عنده عالم كامل جوّا",
   "emphasis": "عالم كامل"
  },
  {
   "start": 177.11,
   "end": 178.53,
   "text": "عنده ذكريات ما منعرفها…",
   "emphasis": ""
  },
  {
   "start": 178.53,
   "end": 181.21,
   "text": "وأشياء علّمته الحياة إياها بالطريقة الصعبة",
   "emphasis": ""
  },
  {
   "start": 181.53,
   "end": 184.0,
   "text": "وقرارات يمكن لليوم مش عارف إذا كانت صح",
   "emphasis": ""
  },
  {
   "start": 184.33,
   "end": 185.54,
   "text": "وأشياء نفسه يحكيها…",
   "emphasis": ""
  },
  {
   "start": 185.54,
   "end": 187.43,
   "text": "بس ما لقى الشخص اللي يعرف يسمعه",
   "emphasis": "يسمعه"
  },
  {
   "start": 187.84,
   "end": 189.98,
   "text": "وهذا ما بيعني إنه كل الناس على حق…",
   "emphasis": ""
  },
  {
   "start": 189.98,
   "end": 191.96,
   "text": "ولا إنه كل اختلاف سببه سوء فهم",
   "emphasis": ""
  },
  {
   "start": 192.4,
   "end": 193.33,
   "text": "في ظلم حقيقي…",
   "emphasis": ""
  },
  {
   "start": 193.33,
   "end": 194.07,
   "text": "وفي أخطاء…",
   "emphasis": ""
  },
  {
   "start": 194.07,
   "end": 196.12,
   "text": "وفي تصرّفات لازم نوقف عندها",
   "emphasis": ""
  },
  {
   "start": 196.57,
   "end": 197.79,
   "text": "بس حتى وإحنا بنختلف…",
   "emphasis": ""
  },
  {
   "start": 197.79,
   "end": 199.78,
   "text": "بنقدر نترك مساحة لاحتمال إنّا مش",
   "emphasis": "مساحة"
  },
  {
   "start": 199.78,
   "end": 201.08,
   "text": "شايفين الصورة كاملة",
   "emphasis": ""
  },
  {
   "start": 201.44,
   "end": 203.93,
   "text": "وممكن نفهم الإنسان من غير ما نوافقه…",
   "emphasis": ""
  },
  {
   "start": 203.93,
   "end": 205.82,
   "text": "ونحبّه ونحط حدود بنفس الوقت",
   "emphasis": ""
  },
  {
   "start": 206.16,
   "end": 208.5,
   "text": "ونراجع رأينا من غير ما نخسر كرامتنا [؟]",
   "emphasis": ""
  },
  {
   "start": 210.09,
   "end": 211.88,
   "text": "وعشان هيك صرت أشوف إنه أصعب",
   "emphasis": ""
  },
  {
   "start": 211.88,
   "end": 214.56,
   "text": "الحوارات مش دايماً اللي بنخوضها مع غيرنا",
   "emphasis": ""
  },
  {
   "start": 214.94,
   "end": 216.04,
   "text": "أحياناً أصعب حوار…",
   "emphasis": ""
  },
  {
   "start": 216.04,
   "end": 217.53,
   "text": "هو اللي بنخوضه مع حالنا",
   "emphasis": "مع حالنا"
  },
  {
   "start": 217.84,
   "end": 219.52,
   "text": "لما نسأل إذا إحنا فعلاً مرتاحين",
   "emphasis": ""
  },
  {
   "start": 219.52,
   "end": 221.06,
   "text": "بالاختيارات اللي عايشينها",
   "emphasis": ""
  },
  {
   "start": 221.51,
   "end": 224.92,
   "text": "وهل إحنا متمسّكين بقناعاتنا لأنّا لسّه مؤمنين فيها؟",
   "emphasis": ""
  },
  {
   "start": 224.92,
   "end": 226.96,
   "text": "ولا لأنّا خايفين نكتشف إنها ما",
   "emphasis": "خايفين"
  },
  {
   "start": 226.96,
   "end": 227.64,
   "text": "عادت إلنا [؟]",
   "emphasis": ""
  },
  {
   "start": 227.99,
   "end": 230.48,
   "text": "وهل إحنا بنحاول نفهم الناس فعلاً؟",
   "emphasis": ""
  },
  {
   "start": 230.48,
   "end": 233.74,
   "text": "ولا بس بنحاول نلاقي تفسير يخلّينا مرتاحين",
   "emphasis": "مرتاحين"
  },
  {
   "start": 235.26,
   "end": 237.86,
   "text": "يمكن ما عندي إجابات جاهزة عن كل هالأسئلة…",
   "emphasis": ""
  },
  {
   "start": 237.86,
   "end": 239.91,
   "text": "بس بعرف إنه في أشياء بتتغيّر فينا",
   "emphasis": ""
  },
  {
   "start": 240.19,
   "end": 241.86,
   "text": "مش لما حدا يعطينا الجواب…",
   "emphasis": ""
  },
  {
   "start": 241.86,
   "end": 243.85,
   "text": "لكن لما نوقف قدّام حالنا ونسمح",
   "emphasis": ""
  },
  {
   "start": 243.85,
   "end": 246.1,
   "text": "لسؤال واحد إنه يغيّر الطريقة اللي",
   "emphasis": "سؤال واحد"
  },
  {
   "start": 246.1,
   "end": 247.35,
   "text": "بنشوف فيها الأمور",
   "emphasis": ""
  },
  {
   "start": 247.67,
   "end": 249.68,
   "text": "وعشان هيك «ما لا يُقال» بالنسبة",
   "emphasis": ""
  },
  {
   "start": 249.68,
   "end": 251.43,
   "text": "إلي مش مساحة نحكي فيها عن",
   "emphasis": ""
  },
  {
   "start": 251.43,
   "end": 253.36,
   "text": "الأشياء اللي ما بنحكيها [؟] بس",
   "emphasis": ""
  },
  {
   "start": 253.63,
   "end": 255.55,
   "text": "هي كمان مساحة نراجع فيها الأشياء",
   "emphasis": "نراجع"
  },
  {
   "start": 255.55,
   "end": 257.61,
   "text": "اللي طول عمرنا مفكّرين إنّا فاهمينها [؟]",
   "emphasis": ""
  },
  {
   "start": 259.37,
   "end": 260.2,
   "text": "وقبل ما تروح…",
   "emphasis": ""
  },
  {
   "start": 260.2,
   "end": 261.95,
   "text": "خلّيني أتركك مع فكرة واحدة",
   "emphasis": ""
  },
  {
   "start": 262.26,
   "end": 264.29,
   "text": "يمكن في قصة أو انطباع بحياتك…",
   "emphasis": ""
  },
  {
   "start": 264.29,
   "end": 266.33,
   "text": "لليوم بتحكيها بنفس الطريقة",
   "emphasis": ""
  },
  {
   "start": 266.62,
   "end": 267.15,
   "text": "عن شخص…",
   "emphasis": ""
  },
  {
   "start": 267.15,
   "end": 267.99,
   "text": "أو عن موقف…",
   "emphasis": ""
  },
  {
   "start": 267.99,
   "end": 269.15,
   "text": "أو حتى عن حالك",
   "emphasis": ""
  },
  {
   "start": 269.59,
   "end": 271.38,
   "text": "جرّب ترجع تفكّر فيها مرّة تانية",
   "emphasis": "مرّة تانية"
  },
  {
   "start": 271.67,
   "end": 273.06,
   "text": "مش حتى تبرّر اللي صار…",
   "emphasis": ""
  },
  {
   "start": 273.06,
   "end": 274.53,
   "text": "ولا حتى تغيّر الحقيقة",
   "emphasis": ""
  },
  {
   "start": 274.79,
   "end": 276.08,
   "text": "بس حتى تشوف إذا في إشي",
   "emphasis": ""
  },
  {
   "start": 276.08,
   "end": 277.21,
   "text": "ما انتبهت له وقتها",
   "emphasis": ""
  },
  {
   "start": 277.54,
   "end": 278.84,
   "text": "يمكن ما يتغيّر رأيك…",
   "emphasis": ""
  },
  {
   "start": 278.84,
   "end": 280.39,
   "text": "بس يمكن تكتشف إشي جديد",
   "emphasis": ""
  },
  {
   "start": 280.71,
   "end": 282.97,
   "text": "ويمكن تفهم لأول مرّة ليش هالقصة",
   "emphasis": ""
  },
  {
   "start": 282.97,
   "end": 284.24,
   "text": "ضلّت معك كل هالوقت",
   "emphasis": ""
  },
  {
   "start": 284.83,
   "end": 285.53,
   "text": "لأنه مرّات…",
   "emphasis": ""
  },
  {
   "start": 285.53,
   "end": 287.47,
   "text": "إحنا ما بنحتاج نغيّر الماضي",
   "emphasis": "الماضي"
  },
  {
   "start": 287.76,
   "end": 289.65,
   "text": "قد ما بنحتاج نفهم شو عمل فينا",
   "emphasis": "نفهم"
  },
  {
   "start": 290.15,
   "end": 291.36,
   "text": "أنا همام ديك…",
   "emphasis": ""
  },
  {
   "start": 291.36,
   "end": 292.81,
   "text": "وهذا ما لا يُقال",
   "emphasis": ""
  }
 ]
}