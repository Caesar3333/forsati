# Root environment template for Forsati
# Copy to .env and adjust values before running.

# Global
COMPOSE_PROJECT_NAME=forsati
DOMAIN=forsati.org

# Network
NGINX_HTTP_PORT=8080
NGINX_HTTPS_PORT=8443

# Object storage (encrypted at rest; never store raw sensitive docs in DB)
S3_ENDPOINT=https://s3.example.com
S3_ACCESS_KEY=changeme
S3_SECRET_KEY=changeme
S3_BUCKET=forsati-secure

# Observability
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

