{
  "roles": [
    {
      "key": "admin_owner",
      "label": "Admin Owner",
      "description": "Full system control with editable roles and permissions",
      "default_scopes": ["platform"],
      "permissions": ["*"]
    },
    {
      "key": "super_admin",
      "label": "Super Admin",
      "description": "Full platform operations except owner-only controls",
      "default_scopes": ["platform"],
      "permissions": [
        "user.read",
        "user.update",
        "user.suspend",
        "user.verify",
        "org.read",
        "org.update",
        "role.assign",
        "opp.read",
        "opp.create",
        "opp.update",
        "opp.publish",
        "opp.unpublish",
        "opp.delete",
        "opp.moderate",
        "app.read",
        "app.export",
        "app.move_stage",
        "app.comment",
        "app.reject",
        "app.accept",
        "service.create",
        "service.update",
        "service.publish",
        "provider.approve",
        "provider.suspend",
        "order.read",
        "order.refund",
        "payout.manage",
        "program.create",
        "cohort.manage",
        "enrollment.manage",
        "attendance.manage",
        "certificate.issue",
        "plan.manage",
        "subscription.manage",
        "invoice.read",
        "refund.manage",
        "coupon.manage",
        "blog.manage",
        "faq.manage",
        "pages.manage",
        "ticket.manage",
        "ticket.assign",
        "ticket.close",
        "report.read",
        "report.export",
        "audit.read",
        "settings.manage",
        "settings.notifications",
        "settings.seo",
        "settings.payments",
        "settings.language",
        "settings.extensions",
        "settings.maintenance",
        "settings.gdpr",
        "settings.sitemap",
        "settings.robots",
        "settings.custom_css",
        "settings.frontend"
      ]
    },
    {
      "key": "moderator",
      "label": "Moderator",
      "description": "Moderates content and reported activity",
      "default_scopes": ["platform"],
      "permissions": ["opp.moderate", "app.read", "app.comment", "user.read", "ticket.manage", "report.read"]
    },
    {
      "key": "publisher",
      "label": "Publisher",
      "description": "Manages platform content",
      "default_scopes": ["platform"],
      "permissions": ["blog.manage", "faq.manage", "pages.manage"]
    },
    {
      "key": "finance_admin",
      "label": "Finance Admin",
      "description": "Manages billing, invoices, and refunds",
      "default_scopes": ["platform"],
      "permissions": [
        "plan.manage",
        "subscription.manage",
        "invoice.read",
        "refund.manage",
        "coupon.manage",
        "order.read",
        "order.refund",
        "payout.manage"
      ]
    },
    {
      "key": "support_agent",
      "label": "Support Agent",
      "description": "Handles support tickets and user inquiries",
      "default_scopes": ["platform"],
      "permissions": ["ticket.manage", "ticket.assign", "ticket.close", "user.read"]
    },
    {
      "key": "marketplace_provider",
      "label": "Marketplace Provider",
      "description": "Publishes services and manages orders",
      "default_scopes": ["marketplace_provider", "self"],
      "permissions": [
        "service.create",
        "service.update",
        "service.publish",
        "order.read",
        "payout.manage",
        "profile.update"
      ]
    },
    {
      "key": "organization_owner",
      "label": "Organization Owner",
      "description": "Owns organization and manages hiring operations",
      "default_scopes": ["organization"],
      "permissions": [
        "org.read",
        "org.update",
        "role.assign",
        "opp.read",
        "opp.create",
        "opp.update",
        "opp.publish",
        "opp.unpublish",
        "opp.delete",
        "app.read",
        "app.move_stage",
        "app.comment",
        "app.reject",
        "app.accept",
        "subscription.manage",
        "invoice.read"
      ]
    },
    {
      "key": "hr_manager",
      "label": "HR Manager",
      "description": "Manages applicants and hiring pipelines",
      "default_scopes": ["organization"],
      "permissions": [
        "opp.read",
        "opp.create",
        "opp.update",
        "opp.publish",
        "app.read",
        "app.move_stage",
        "app.comment",
        "app.reject",
        "app.accept"
      ]
    },
    {
      "key": "recruiter",
      "label": "Recruiter",
      "description": "Sources candidates and manages applications",
      "default_scopes": ["organization"],
      "permissions": ["opp.read", "app.read", "app.move_stage", "app.comment"]
    },
    {
      "key": "interviewer",
      "label": "Interviewer",
      "description": "Evaluates candidates during interviews",
      "default_scopes": ["organization"],
      "permissions": ["app.read", "app.comment"]
    },
    {
      "key": "opportunity_manager",
      "label": "Opportunity Manager",
      "description": "Manages volunteer, scholarship, and program opportunities",
      "default_scopes": ["organization"],
      "permissions": ["opp.read", "opp.create", "opp.update", "opp.publish", "opp.unpublish"]
    },
    {
      "key": "job_seeker",
      "label": "Job Seeker",
      "description": "Finds and applies to opportunities",
      "default_scopes": ["self"],
      "permissions": ["profile.update", "app.submit", "app.read"]
    },
    {
      "key": "volunteer_applicant",
      "label": "Volunteer/Scholarship Applicant",
      "description": "Applies to volunteer and scholarship opportunities",
      "default_scopes": ["self"],
      "permissions": ["profile.update", "app.submit", "app.read"]
    }
  ]
}
